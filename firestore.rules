rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'displayName', 'email', 'createdAt'])
        && data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128
        && data.displayName is string && data.displayName.size() <= 100
        && data.email is string && data.email.size() <= 150
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000))
        && data.createdAt is string && data.createdAt.size() <= 50;
    }

    function isValidResume(data) {
      return data.keys().hasAll(['userId', 'title', 'templateId', 'theme', 'docData', 'createdAt', 'updatedAt'])
        && data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.templateId is string && data.templateId.size() <= 50
        && data.theme is string && data.theme.size() <= 50
        && data.docData is string && data.docData.size() <= 500000
        && (!('photo' in data) || (data.photo is string && data.photo.size() <= 2000000))
        && (!('typography' in data) || (data.typography is string && data.typography.size() <= 10000))
        && data.createdAt is string && data.createdAt.size() <= 50
        && data.updatedAt is string && data.updatedAt.size() <= 50;
    }

    // Connection test route
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidUserProfile(incoming()) && incoming().userId == existing().userId;
      allow delete: if false;

      // Resumes Subcollection
      match /resumes/{resumeId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(resumeId) && isValidResume(incoming());
        allow update: if isOwner(userId) && isValidId(resumeId) && isValidResume(incoming()) 
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId) && isValidId(resumeId);
      }
    }
  }
}
